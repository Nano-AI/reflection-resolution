# Copy to .env and fill in. .env is gitignored; this file is not.
#
# COMPANY_PREFIX -- the Java package root that means "our code".
# Everything under it resolves to the unnamed module (classpath), so it is
# never a Java 21 blocker. Everything outside it is JDK or third-party.
#
# Multiple roots: comma-separate them.
#   COMPANY_PREFIX=com.example,org.example.internal
COMPANY_PREFIX=com.example
